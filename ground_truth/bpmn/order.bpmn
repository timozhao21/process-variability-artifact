<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_GroundTruth_Order"
             targetNamespace="https://example.org/spaghetti-experiment/ground-truth/order">
  <process id="GroundTruth_Order" name="Ground Truth - Alternative Ordering" isExecutable="false">
    <startEvent id="StartEvent" name="start" />
    <task id="Task_Register" name="Register" />
    <exclusiveGateway id="Gateway_Order_Choice" name="choose order" />
    <task id="Task_Check_First" name="Check" />
    <task id="Task_Assess_Second" name="Assess" />
    <task id="Task_Assess_First" name="Assess" />
    <task id="Task_Check_Second" name="Check" />
    <exclusiveGateway id="Gateway_Order_Join" name="order branch joined" />
    <task id="Task_Decide" name="Decide" />
    <task id="Task_Notify" name="Notify" />
    <task id="Task_Archive" name="Archive" />
    <endEvent id="EndEvent" name="end" />

    <sequenceFlow id="Flow_Start_Register" sourceRef="StartEvent" targetRef="Task_Register" />
    <sequenceFlow id="Flow_Register_OrderChoice" sourceRef="Task_Register" targetRef="Gateway_Order_Choice" />
    <sequenceFlow id="Flow_OrderChoice_CheckFirst" name="Check before Assess" sourceRef="Gateway_Order_Choice" targetRef="Task_Check_First" />
    <sequenceFlow id="Flow_CheckFirst_AssessSecond" sourceRef="Task_Check_First" targetRef="Task_Assess_Second" />
    <sequenceFlow id="Flow_AssessSecond_OrderJoin" sourceRef="Task_Assess_Second" targetRef="Gateway_Order_Join" />
    <sequenceFlow id="Flow_OrderChoice_AssessFirst" name="Assess before Check" sourceRef="Gateway_Order_Choice" targetRef="Task_Assess_First" />
    <sequenceFlow id="Flow_AssessFirst_CheckSecond" sourceRef="Task_Assess_First" targetRef="Task_Check_Second" />
    <sequenceFlow id="Flow_CheckSecond_OrderJoin" sourceRef="Task_Check_Second" targetRef="Gateway_Order_Join" />
    <sequenceFlow id="Flow_OrderJoin_Decide" sourceRef="Gateway_Order_Join" targetRef="Task_Decide" />
    <sequenceFlow id="Flow_Decide_Notify" sourceRef="Task_Decide" targetRef="Task_Notify" />
    <sequenceFlow id="Flow_Notify_Archive" sourceRef="Task_Notify" targetRef="Task_Archive" />
    <sequenceFlow id="Flow_Archive_End" sourceRef="Task_Archive" targetRef="EndEvent" />
  </process>
</definitions>
